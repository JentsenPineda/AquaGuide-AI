{
  "expo": {
    "name": "AquaGuide AI",
    "slug": "GoldfishCareAI",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./Icon/icon.png",
    "scheme": "aquaguide-ai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zeiappdev.aquaguideai",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./Icon/iconnn.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zeiappdev.aquaguideai"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.webp"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/transparent-splash.png",
          "imageWidth": 1,
          "backgroundColor": "#EAFBFE",
          "dark": {
            "image": "./assets/images/transparent-splash.png",
            "backgroundColor": "#EAFBFE"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5649447-0b04-4550-89d3-9ac021a27185"
      }
    },
    "owner": "zeiappdev"
  }
}
